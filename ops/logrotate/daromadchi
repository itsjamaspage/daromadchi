# Daromadchi log rotation. Install on the VPS:
#   sudo cp ops/logrotate/daromadchi /etc/logrotate.d/daromadchi
#   sudo chmod 644 /etc/logrotate.d/daromadchi
#   sudo logrotate --debug /etc/logrotate.d/daromadchi   # dry-run: shows what it would do
#   sudo logrotate --force /etc/logrotate.d/daromadchi    # rotate now (clears the current backlog)
#
# WHY: the crontab appends every job's output to $HOME/daromadchi-cron.log with no
# rotation — it reached 18 MB. cron-runner also writes per-job logs under
# logs/, and the freshness watchdog writes logs/sync-freshness.log. None rotate.
#
# copytruncate is REQUIRED here: every writer appends with shell `>>` and never
# reopens the file, so a rename-based rotation would leave them writing to the old
# (now-unlinked) inode and the new file would stay empty. copytruncate copies then
# truncates in place, so the appenders keep writing to the same path.

/root/daromadchi-cron.log
/var/www/daromadchi/logs/*.log
{
    daily
    rotate 14
    size 25M
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}

# NOTE — pm2's own stdout/stderr logs (~/.pm2/logs/daromadchi-*.log) are rotated
# by the pm2-logrotate module, not this file:
#   pm2 install pm2-logrotate
#   pm2 set pm2-logrotate:max_size 25M
#   pm2 set pm2-logrotate:retain 14
#   pm2 set pm2-logrotate:compress true
