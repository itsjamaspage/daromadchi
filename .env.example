# ─── PostgreSQL (Drizzle ORM) ─────────────────────────────────────────────────
# On the VPS this points to the self-hosted Postgres running on the same box.
DATABASE_URL=postgresql://user:password@localhost:5432/daromadchi

# ─── App URL ──────────────────────────────────────────────────────────────────
# Your deployed domain (no trailing slash)
NEXT_PUBLIC_APP_URL=https://daromadchi.uz
NEXT_PUBLIC_SITE_URL=https://daromadchi.uz

# ─── Encryption ───────────────────────────────────────────────────────────────
# AES-256-CBC key for encrypting marketplace API tokens stored in DB
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-64-char-hex-key-here

# ─── Cron jobs ────────────────────────────────────────────────────────────────
# Secret header value for /api/cron/* routes. Read on the VPS by
# /var/www/daromadchi/cron-runner.sh (installed by .github/workflows/deploy.yml)
# and passed as `x-cron-secret` / `Authorization: Bearer …` when the system
# crontab hits /api/cron/sync and /api/cron/telegram-digest.
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# ─── Telegram bot ─────────────────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_BOT_USERNAME=your_bot_username
# Random secret for validating Telegram webhook POSTs (32–256 chars)
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret-here

# ─── Payme (payment provider) ─────────────────────────────────────────────────
# Get from: Payme merchant cabinet
PAYME_MERCHANT_ID=your-payme-merchant-id
PAYME_SECRET_KEY=your-payme-secret-key

# ─── Click (payment provider) ─────────────────────────────────────────────────
# Get from: Click merchant cabinet
CLICK_SERVICE_ID=your-click-service-id
CLICK_MERCHANT_ID=your-click-merchant-id
CLICK_SECRET_KEY=your-click-secret-key

# ─── SMTP (Email verification) ───────────────────────────────────────────────
# For Gmail: use an App Password (Google Account → Security → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Daromadchi <your-email@gmail.com>

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=your-email@gmail.com
