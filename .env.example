# ─── PostgreSQL (Drizzle ORM) ─────────────────────────────────────────────────
# On the VPS this points to the self-hosted Postgres running on the same box.
DATABASE_URL=postgresql://user:password@localhost:5432/daromadchi

# ─── App URL ──────────────────────────────────────────────────────────────────
# Your deployed domain (no trailing slash)
NEXT_PUBLIC_APP_URL=https://daromadchi.uz
NEXT_PUBLIC_SITE_URL=https://daromadchi.uz

# ─── Encryption ───────────────────────────────────────────────────────────────
# AES-256-CBC key for encrypting marketplace API tokens stored in DB
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-64-char-hex-key-here

# ─── Cron jobs ────────────────────────────────────────────────────────────────
# Secret header value for /api/cron/* routes. Read on the VPS by
# /var/www/daromadchi/cron-runner.sh (installed by .github/workflows/deploy.yml)
# and passed as `x-cron-secret` / `Authorization: Bearer …` when the system
# crontab hits /api/cron/sync and /api/cron/telegram-digest.
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# ─── Telegram bot ─────────────────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_BOT_USERNAME=your_bot_username
# Chat(s) that receive operational alerts: feedback, deletion requests and the
# questions people send the bot. Comma-separated for more than one operator.
# Unset falls back to the chat that has always received them.
TELEGRAM_ADMIN_CHAT_ID=

# Account lifecycle: actually DELETE accounts that have completed the whole
# freeze ladder (a year silent, warned, frozen, and still silent). Unset, the
# daily sweep logs exactly who it would delete and deletes nobody. Warning and
# freezing run either way — both are reversible; this switch governs only the
# irreversible step. Do not set it until the privacy policy stating the periods
# is live.
ACCOUNT_LIFECYCLE_DELETE_ENABLED=
# Random secret for validating Telegram webhook POSTs (32–256 chars)
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret-here

# ─── Payments (ATMOS — sole provider, hosted checkout) ───────────────────────
# Card entry happens on ATMOS's hosted page; no raw PAN ever touches our servers.
# All amounts are in TIYIN (1 UZS = 100 tiyin). Server-only — never sent to the
# client, never logged.
ATMOS_BASE_URL=https://apigw.atmos.uz
ATMOS_STORE_ID=11054
ATMOS_CONSUMER_KEY=your-atmos-consumer-key
ATMOS_CONSUMER_SECRET=your-atmos-consumer-secret
# Separate secret used ONLY to verify the callback `sign` (not the OAuth secret).
ATMOS_CALLBACK_API_KEY=your-atmos-callback-api-key
# IKPU/OFD taxonomy code for the SaaS subscription being sold (fiscal receipt).
ATMOS_SERVICE_IKPU=10305008005000000
# Where ATMOS redirects the browser after hosted checkout.
ATMOS_SUCCESS_URL=https://daromadchi.uz/billing/atmos/return
# Optional: callback source-IP allowlist. Default OFF; set to 1/true to enforce.
# ATMOS_CALLBACK_IP_ALLOWLIST=1
# ATMOS_CALLBACK_CIDR=92.63.207.0/24

# ─── SMTP (Email verification) ───────────────────────────────────────────────
# For Gmail: use an App Password (Google Account → Security → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Daromadchi <your-email@gmail.com>

# ─── Admin ────────────────────────────────────────────────────────────────────
# The single owner account. Gates the category-review endpoints AND the
# owner-only analytics dashboard at /dashboard/admin (+ /api/admin/analytics).
# Compared case-insensitively against the signed-in user's email. Leave it unset
# and NOBODY is an admin — every admin surface fails closed.
ADMIN_EMAIL=your-email@gmail.com

# ─── Google Analytics 4 (optional, consent-gated) ─────────────────────────────
# GA4 Measurement ID. NEXT_PUBLIC_* is inlined at BUILD time, so this must be
# present in the environment when the app is built on the VPS. GA only loads in
# production AND after the visitor accepts analytics cookies. Leave unset to
# disable analytics entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
